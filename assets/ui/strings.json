    { "id": "track.circuit-4.desc", "text": "Figure-of-eight on the workbench: over the bridge, under it a lap later, a chicane and a broad banked bend." },
    { "id": "track.circuit-5.name", "text": "Highbank Raceway" },
    { "id": "track.circuit-5.desc", "text": "Flat-out banked sweepers, a tight infield that punishes late braking and a flyover above the back straight." }
