# /etc/slotrush-server/env  (root:slotrush-server, mode 0640). Never commit real values; never put them in a VITE_ variable.
# Every setting is validated at start; a bad value stops the service with the variable's name in the journal.

SLOTRUSH_HOST=127.0.0.1
SLOTRUSH_PORT=8787
# exact Origin values allowed for /ws upgrades and /api POSTs (same origin as the static site)
SLOTRUSH_ALLOWED_ORIGINS=https://slotrush.jdwd40.com

# capacity (see docs/online-server.md "Resource limits" for what these support on the 256M / 60% CPU unit)
SLOTRUSH_ROOM_CAP=6
SLOTRUSH_MAX_CONNECTIONS=48
SLOTRUSH_MAX_CONNECTIONS_PER_IP=8
# room creation allowance per client address / account (docs/online-server.md "Room creation allowance"): open rooms,
# and rooms created in any SLOTRUSH_ROOM_CREATE_WINDOW_S seconds. Joining a room is never limited by these.
SLOTRUSH_ROOMS_PER_IP=3
SLOTRUSH_ROOMS_PER_ACCOUNT=2
SLOTRUSH_ROOM_CREATES=20
SLOTRUSH_ROOM_CREATE_WINDOW_S=600
SLOTRUSH_SNAPSHOT_HZ=20

# seat and timing policy
SLOTRUSH_RECONNECT_GRACE_S=20
SLOTRUSH_INPUT_TIMEOUT_MS=1000
SLOTRUSH_OVERLOAD_ABORT_MS=5000
SLOTRUSH_LOBBY_IDLE_S=1800
SLOTRUSH_RESULTS_IDLE_S=600
SLOTRUSH_ROOM_MAX_S=10800

# the game's own PostgreSQL 17 database and role (created once by the owner; see the runbook)
DATABASE_URL=postgres://slotrush:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/slotrush
SLOTRUSH_DB_POOL_MAX=3
# at least 32 random characters: openssl rand -base64 48
SLOTRUSH_SESSION_SECRET=CHANGE_ME_SESSION_SECRET
SLOTRUSH_COOKIE_SECURE=1

# career points (docs/career.md): 1st,2nd,3rd...; 4th and lower, DQ and DNF score 0. The scoring version stored with every
# award is derived from these numbers, so a change only affects races finished after it. Default 10,6,4.
SLOTRUSH_CAREER_POINTS=10,6,4
# results the database cannot take yet are queued here (fsynced files, retried, drained at start); required in production.
# The directory is created by systemd (StateDirectory=slotrush-server in the unit).
SLOTRUSH_SPOOL_DIR=/var/lib/slotrush-server/spool

SLOTRUSH_LOG_LEVEL=info
